def det_nbre_occurences(chaine):
    nbre_occurence= {} 
    v=chaine.split()
    for val in v:
        nbre_occurence[f'{val}']=chaine.count(val)



    return nbre_occurence

def occurence(chaine):
    dict={}
    mots=chaine.split()
    for mot in mots:
        compteur=mots.count(mot)
        dict[mot]=compteur # ajouter une valeur à un dictionnaire 




    return dict




